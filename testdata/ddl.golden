-- create comment
CREATE TABLE `t` (
  `c` VARCHAR(255) NOT NULL COMMENT 'it''s'
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- create foreign key
CREATE TABLE `t` (
  `user_id` BIGINT UNSIGNED NOT NULL,
  CONSTRAINT `t_user_id_foreign` FOREIGN KEY (`user_id`) REFERENCES `users` (`id`) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- create indexes
CREATE TABLE `t` (
  `a` VARCHAR(255) NOT NULL,
  `b` VARCHAR(255) NOT NULL,
  CONSTRAINT `t_a_b_unique` UNIQUE (`a`, `b`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;
CREATE INDEX `t_b_index` ON `t` (`b`);

-- alter add, drop, rename
ALTER TABLE `t` ADD COLUMN `nick` VARCHAR(255) NULL;
ALTER TABLE `t` DROP COLUMN `old`;
ALTER TABLE `t` RENAME COLUMN `a` TO `b`;

-- alter change column
ALTER TABLE `t` MODIFY COLUMN `nick` VARCHAR(50) NOT NULL;

-- alter indexes and keys
ALTER TABLE `t` ADD COLUMN `team_id` BIGINT UNSIGNED NOT NULL;
ALTER TABLE `t` ADD CONSTRAINT `t_email_unique` UNIQUE (`email`);
ALTER TABLE `t` DROP INDEX `t_nick_index`;
ALTER TABLE `t` ADD CONSTRAINT `t_team_id_foreign` FOREIGN KEY (`team_id`) REFERENCES `teams` (`id`);
ALTER TABLE `t` DROP FOREIGN KEY `t_company_id_foreign`;

