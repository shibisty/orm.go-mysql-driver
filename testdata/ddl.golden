-- create boolean
CREATE TABLE `t` (
  `c` TINYINT(1) NOT NULL DEFAULT 1
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- create char
CREATE TABLE `t` (
  `c` CHAR(2) NOT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- create string
CREATE TABLE `t` (
  `c` VARCHAR(100) NOT NULL DEFAULT 'x'
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- create text
CREATE TABLE `t` (
  `c` TEXT NOT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- create mediumText
CREATE TABLE `t` (
  `c` MEDIUMTEXT NOT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- create longText
CREATE TABLE `t` (
  `c` LONGTEXT NOT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- create tinyText
CREATE TABLE `t` (
  `c` TINYTEXT NOT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- create tinyInteger
CREATE TABLE `t` (
  `c` TINYINT NOT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- create smallInteger
CREATE TABLE `t` (
  `c` SMALLINT NOT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- create mediumInteger
CREATE TABLE `t` (
  `c` MEDIUMINT NOT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- create integer
CREATE TABLE `t` (
  `c` INT NOT NULL DEFAULT 0
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- create bigInteger
CREATE TABLE `t` (
  `c` BIGINT NOT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- create unsignedInteger
CREATE TABLE `t` (
  `c` INT UNSIGNED NOT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- create increments
CREATE TABLE `t` (
  `c` INT UNSIGNED NOT NULL AUTO_INCREMENT,
  PRIMARY KEY (`c`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- create id
CREATE TABLE `t` (
  `id` BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- create decimal
CREATE TABLE `t` (
  `c` DECIMAL(10,2) NOT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- create double
CREATE TABLE `t` (
  `c` DOUBLE NOT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- create float
CREATE TABLE `t` (
  `c` FLOAT NOT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- create date
CREATE TABLE `t` (
  `c` DATE NOT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- create dateTime
CREATE TABLE `t` (
  `c` DATETIME(3) NOT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- create dateTimeTz
CREATE TABLE `t` (
  `c` DATETIME NOT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- create time
CREATE TABLE `t` (
  `c` TIME NOT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- create timestamp
CREATE TABLE `t` (
  `c` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- create timestampTz
CREATE TABLE `t` (
  `c` TIMESTAMP NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- create year
CREATE TABLE `t` (
  `c` YEAR NOT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- create binary
CREATE TABLE `t` (
  `c` BLOB NOT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- create json
CREATE TABLE `t` (
  `c` JSON NOT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- create jsonb
CREATE TABLE `t` (
  `c` JSON NOT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- create uuid
CREATE TABLE `t` (
  `c` CHAR(36) NOT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- create ulid
CREATE TABLE `t` (
  `c` CHAR(26) NOT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- create enum
CREATE TABLE `t` (
  `c` ENUM('a', 'b') NOT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- create set
CREATE TABLE `t` (
  `c` SET('a', 'b') NOT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- create macAddress
CREATE TABLE `t` (
  `c` VARCHAR(17) NOT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- create ipAddress
CREATE TABLE `t` (
  `c` VARCHAR(45) NOT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- create geometry
CREATE TABLE `t` (
